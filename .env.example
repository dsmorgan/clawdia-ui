# Clawdia UI Configuration
# Copy to .env and fill in values

# App
SECRET_KEY=change-me-to-a-random-string
DEBUG=false
ALLOWED_HOSTS=*

# Database
DATABASE_PATH=/app/data/clawdia.db

# Quick Actions
QUICK_ACTIONS_PATH=/app/config/quick_actions.yaml

# OpenClaw Gateway
OPENCLAW_HOST=10.11.24.52
OPENCLAW_PORT=18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
OPENCLAW_AGENT_ID=main

# OIDC / Authentik
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_ISSUER=https://auth.yourdomain.com/application/o/clawdia-ui/
LOGIN_REDIRECT_URL=/
LOGOUT_REDIRECT_URL=/logged-out
